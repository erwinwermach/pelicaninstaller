# Pelican installer - pre-filled configuration
# Save as /etc/pelican-installer/installer.conf (mode 600) on the server,
# or pass with: sudo bash installer.sh --config /path/to/this/file
#
# If this file does not exist, the installer asks the same questions once.

# Your domain, managed by Cloudflare (no http://, no subdomain)
DOMAIN=example.com

# Cloudflare API token with permissions:
#   Account: Cloudflare Tunnel - Edit
#   Zone:    Zone - Read, DNS - Edit, SSL and Certificates - Edit
# Create at https://dash.cloudflare.com/profile/api-tokens
# (the installer double-checks the token length so paste glitches get caught)
CF_API_TOKEN=

# Optional: if your token cannot list accounts, paste your Account ID
# (https://dash.cloudflare.com -> right sidebar -> Account ID)
CF_ACCOUNT_ID=

# What to do when a tunnel named pelican-<domain> already exists on this
# account (e.g. from a previous install or another server):
#   (unset)  = automatic (recommended): if the existing tunnel has NO active
#              connectors (old server offline) it is replaced automatically;
#              if it is live you are asked interactively (reuse/replace/clean/abort)
#   reuse    = always adopt the existing tunnel (old server still running)
#   replace  = always delete the old tunnel + its DNS records, create fresh
#   clean    = additionally remove managed game/SFTP A records
# Tunnels with other names are never touched.
CF_EXISTING=

TIMEZONE=UTC

PANEL_SUBDOMAIN=panel
NODE_SUBDOMAIN=node
GAME_SUBDOMAIN_PREFIX=game

# Game ports to expose. Each port gets its own tunnel route.
# Format: comma separated list, ranges allowed: 25565-25575,27015
GAME_PORTS=25565-25575

# How players reach game servers (all free, players install nothing):
#   playit    playit.gg tunnels - recommended, fully automatic public addresses
#   bore      open-source bore client vs the free bore.pub relay; the address
#             port changes whenever its systemd service restarts
#             (BORE_RELAY=bore.pub can point to any self-hosted relay)
#   frp-vps   your own VPS as stable relay (e.g. Oracle Cloud Always Free).
#             You will be asked for SSH host/user/password-or-key once.
#   direct    real port forwarding via UPnP - only works WITHOUT CGNAT
#   none      skip game routing
GAME_ROUTING=playit

# playit.gg secret key (https://playit.gg -> Account -> Secret Key).
# Leave empty to run playit-less backends only.
PLAYIT_SECRET_KEY=

# Optional: playit API key (Account -> API keys) for automatic tunnel creation.
PLAYIT_API_KEY=

NODE_NAME=Node-1

# Node resources in MB (empty = automatic: all memory minus 1GB, disk minus 10GB)
NODE_MEMORY=
NODE_DISK=
NODE_CPU=100

# Reboot the server automatically after install (verifies self-healing)
AUTO_REBOOT=yes

# Clean-slate reset before installing?
#   (unset) = ask once during interactive installs; non-interactive runs skip
#             the reset when an install is already in progress (resume), and
#             wipe on machines with no existing state
#   yes     = full reset: removes panel/web/database/Docker/game-tunnel data
#             AND this installer's config/stages/secrets, then re-downloads
#             the installer fresh from GitHub and starts over. The OS, SSH,
#             user accounts and files are never touched.
#   no      = never reset; run with whatever is already installed
WIPE_FIRST=

# Hub plugins from https://hub.pelican.dev:
#   minimal  = modpack-manager, minecraft-modrinth, mclogs-uploader (default)
#   all      = + player-counter, system-status-monitor (heavier pages)
#   none     = hub plugins skipped
#   or a comma list of exact ids, e.g. modpack-manager,mclogs-uploader
PANEL_PLUGINS=minimal

# Set to "no" to skip our own Ops Board / Performance plugins.
INSTALL_SELF_PLUGINS=yes

# Route HTTP apps through the Cloudflare tunnel on app-<port>.<domain>.
# Only Cloudflare HTTP ports work publicly (80/443/8080/8443/2052-2087/2095-2096).
CF_APP_ROUTING=no

# LAN subnet allowed through the firewall (router discovery, local access).
# Empty = auto-detect from default route as /24.
LAN_ALLOW=
